# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Notebooks
.ipynb_checkpoints/

# Trained model artifacts (must be regenerated locally via train.py)
services/classifier/artifacts/*.joblib
services/classifier/artifacts/*.json
!services/classifier/artifacts/.gitkeep

# Datasets — never commit raw data
data/
datasets/
*.zip
*.tar.gz

# Environment files — never commit real secrets
.env
.env.local

# Docker / process pids
*.pid
