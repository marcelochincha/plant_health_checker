# Postgres
POSTGRES_USER=leaf_app
POSTGRES_PASSWORD=leaf_app
POSTGRES_DB=leaf_app

# Shared (consumed by auth and classifier)
DATABASE_URL=postgresql+psycopg2://leaf_app:leaf_app@postgres:5432/leaf_app
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Classifier
ARTIFACTS_DIR=/app/artifacts

# Training (only used when running training)
DATASET_PATH=./datasets/PlantVillage
